# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=arunika
DB_SSLMODE=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters long
JWT_SECRET=change-me-to-a-long-random-secret-value

# ─── SMTP (outgoing email) ────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=changeme
# Optional. From address shown on outgoing mail; falls back to SMTP_USER.
# Most providers reject or flag a From address on a domain they haven't
# verified for this account — set this only if it differs from SMTP_USER.
SMTP_EMAIL=no-reply@example.com

# ─── Application ──────────────────────────────────────────────────────────────
APP_DOMAIN=https://app.example.com

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Backoffice (Admin UI) ────────────────────────────────────────────────────
# URL that the browser uses to reach the backend API.
# In production set this to your real domain, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:8080
BACKOFFICE_PORT=3000

# ─── Midtrans ────────────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-changeme
MIDTRANS_CLIENT_KEY=SB-Mid-client-changeme

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either the absolute path to that JSON file, or its raw JSON content on one line.
# With Docker Compose a path must exist *inside* the container (mount the file),
# so raw JSON is simpler there. Do NOT commit the key file.
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/firebase-service-account.json

# ─── Google Play Billing ──────────────────────────────────────────────────────
# Play Console → Setup → API access → link/create a Google Cloud service
# account with the "Pub/Sub" and "Android Publisher" permissions granted.
# Same format as FIREBASE_SERVICE_ACCOUNT_JSON: an absolute path or raw JSON.
# Do NOT commit the key file. Leave unset to disable Play Billing verification
# (purchase/verify and RTDN endpoints will reject with a clear error).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/google-play-service-account.json
# The app's Android applicationId — must match android/app/build.gradle.kts.
ANDROID_PACKAGE_NAME=com.arunika


# ─── Media uploads (Belajar Huruf) ────────────────────────────────────────────
# Production: the R2 bucket behind the media.haloarunika.com custom domain
# (r2.dev is blocked by Internet Positif). Startup fails in production
# (APP_ENV=production) unless MEDIA_DRIVER=r2 with an https custom domain.
# Development defaults to MEDIA_DRIVER=local: files under MEDIA_LOCAL_DIR,
# served by the API at /media/huruf/…. Leave MEDIA_PUBLIC_BASE_URL empty to
# return relative /media/ URLs that the app and backoffice resolve against
# their API base URL (works through ngrok and an emulator alike).
APP_ENV=development
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=
MEDIA_PUBLIC_BASE_URL=
# MEDIA_DRIVER=r2
# MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=arunika-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://media.haloarunika.com/

# Optional: Huruf tracing thresholds sent to the app in the manifest.
# HURUF_TRACING_RADIUS=22
# HURUF_TRACING_COVERAGE=0.80
# HURUF_TRACING_ACCURACY=0.85
# HURUF_TRACING_DIRECTION=0.70
# HURUF_TRACING_START_TOLERANCE=30
# HURUF_TRACING_MAX_FAILURES=3
