# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Environment files — never commit secrets
.env
.env.local
.env.*.local
# Firebase service account keys (FIREBASE_SERVICE_ACCOUNT_JSON file path)
*firebase*service-account*.json
*firebase-adminsdk*.json

# Compiled binary / build output
arunika_backend
*.exe
*.out

# Go test cache & coverage
# (coverage-baseline.json IS committed — it is the ratchet baseline)
*.test
*.prof
coverage.out
coverage.html
cover.out
reports/

# OS generated files
.DS_Store
Thumbs.db

# Docker volumes / local data
pgdata/

# Flyway local config (may contain credentials)
flyway.conf

# Local debug output from ad-hoc `go run main.go | tee` sessions
*.log
db/seeds/test/.env.e2e.generated
tests/e2e/artifacts/

# Pre-release gate output
prerelease-reports/

# Files uploaded through the E2E stack land in its mounted media directory;
# only the committed e2e-* fixtures belong in git.
db/seeds/test/media/huruf/*
!db/seeds/test/media/huruf/e2e-*
